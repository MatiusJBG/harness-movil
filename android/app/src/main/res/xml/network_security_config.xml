<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- El APK incluye la CA pública del puente (res/raw/harness_ca.pem), copiada
         por scripts/build-apk.ps1 desde %LOCALAPPDATA%\harness-movil\tls\ca.pem.
         Así el WebView confía en el certificado autofirmado también en subrecursos. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/harness_ca" />
        </trust-anchors>
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
